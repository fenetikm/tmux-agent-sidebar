{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "command": "bash hook.sh cursor session-start" }
    ],
    "beforeSubmitPrompt": [
      { "command": "bash hook.sh cursor user-prompt-submit" }
    ],
    "postToolUse": [
      { "command": "bash hook.sh cursor activity-log" }
    ],
    "afterAgentResponse": [
      { "command": "bash hook.sh cursor after-agent-response" }
    ],
    "stop": [
      { "command": "bash hook.sh cursor stop" }
    ],
    "sessionEnd": [
      { "command": "bash hook.sh cursor session-end" }
    ]
  }
}
